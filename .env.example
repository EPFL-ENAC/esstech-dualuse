# Backend configuration (FastAPI + SQLModel + PostgreSQL)
SECRET_KEY=change-me
APP_URL=http://localhost:9000
API_PATH=

DB_HOST=localhost
DB_PORT=5432
DB_NAME=app
DB_USER=user
DB_PASSWORD=password

# Optional: Google sign-in stays disabled (its routes answer 503) until both
# the client id and secret are set. GOOGLE_REDIRECT_URI defaults to this same
# value; only override it if your registered redirect URI differs.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/auth/google/callback
